<Window x:Class="FerreControl.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FerreControl"
        Width="1450"
        Height="850"
        MinWidth="1150"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="250"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ====================================================== -->
        <!-- MENÚ LATERAL                                           -->
        <!-- ====================================================== -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- LOGO -->

                <StackPanel
                    Orientation="Horizontal"
                    Margin="4,6,0,30">

                    <Border Width="42"
                            Height="42"
                            CornerRadius="10"
                            Background="{StaticResource AccentBrush}">

                        <TextBlock
                            Text="F"
                            Foreground="White"
                            FontSize="22"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="FERRE"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="17"/>

                            <TextBlock
                                Text="CONTROL"
                                Foreground="{StaticResource AccentLightBrush}"
                                FontWeight="Bold"
                                FontSize="17"/>

                        </StackPanel>

                        <TextBlock
                            Text="Gestión empresarial"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="11"/>

                    </StackPanel>

                </StackPanel>


                <!-- NAVEGACIÓN -->

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock
                            Text="OPERACIÓN"
                            Foreground="#64748B"
                            FontSize="10"
                            FontWeight="Bold"
                            Margin="12,0,0,8"/>


                        <Button
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnMarcaje_Click">

                            <TextBlock Text="◉   Marcaje"/>

                        </Button>


                        <TextBlock
    Text="GESTIÓN"
    Foreground="#64748B"
    FontSize="10"
    FontWeight="Bold"
    Margin="12,24,0,8"/>


                        <Button
    Style="{StaticResource NavButtonStyle}"
    Click="BtnEmpleados_Click">

                            <TextBlock Text="▣   Empleados"/>

                        </Button>


                        <Button
    Style="{StaticResource NavButtonStyle}"
    Click="BtnHorarios_Click">

                            <TextBlock Text="◷   Horarios"/>

                        </Button>


                        <Button
    Style="{StaticResource NavButtonStyle}"
    Click="BtnSalarios_Click">

                            <TextBlock Text="●   Salarios"/>

                        </Button>


                        <!-- NÓMINA Y PAGOS -->

                        <Button
                            x:Name="btnNomina"
                            Style="{StaticResource NavButtonStyle}"
                            IsEnabled="True"
                            Click="BtnNomina_Click">

                            <TextBlock Text="▤   Nómina"/>

                        </Button>


                        <Button
    Style="{StaticResource NavButtonStyle}"
    Click="BtnBonos_Click">

                            <TextBlock Text="◆   Bonos"/>

                        </Button>


                        <!-- FUTURO -->

                        <Button
    x:Name="btnAdelantos"
    Style="{StaticResource NavButtonStyle}"
    IsEnabled="False">

                            <TextBlock Text="↓   Adelantos"/>

                        </Button>


                        <TextBlock
                            Text="CONTROL"
                            Foreground="#64748B"
                            FontSize="10"
                            FontWeight="Bold"
                            Margin="12,24,0,8"/>


                        <Button
                            Style="{StaticResource NavButtonStyle}"
                            IsEnabled="True"
                            Click="BtnAsistencia_Click">

                            <TextBlock Text="✓   Asistencia"/>

                        </Button>


                        <Button
                            Style="{StaticResource NavButtonStyle}"
                            IsEnabled="False">

                            <TextBlock Text="▤   Documentos"/>

                        </Button>


                        <Button
                            Style="{StaticResource NavButtonStyle}"
                            IsEnabled="True"
                            Click="BtnCarnes_Click">
                            <TextBlock Text="▰   Carnés"/>

                        </Button>


                        <Button
                            Style="{StaticResource NavButtonStyle}"
                            IsEnabled="False">

                            <TextBlock Text="▥   Reportes"/>

                        </Button>


                        <TextBlock
                            Text="SISTEMA"
                            Foreground="#64748B"
                            FontSize="10"
                            FontWeight="Bold"
                            Margin="12,24,0,8"/>


                        <Button
                            Style="{StaticResource NavButtonStyle}"
                            IsEnabled="False">

                            <TextBlock Text="⚙   Configuración"/>

                        </Button>

                    </StackPanel>

                </ScrollViewer>


                <!-- PIE DEL MENÚ -->

                <Border Grid.Row="2"
                        Background="#0A111E"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,15,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="FerreControl Desktop"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="11"/>

                        <TextBlock
                            Text="Versión 1.0"
                            Foreground="#52627A"
                            FontSize="10"
                            Margin="0,3,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>


        <!-- ====================================================== -->
        <!-- CONTENIDO PRINCIPAL                                    -->
        <!-- ====================================================== -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="78"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- CABECERA -->

            <Border
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

                <Grid Margin="26,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock
                        x:Name="txtTituloPagina"
                        Text="Empleados"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>


                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">


                        <!-- NEGOCIO -->

                        <StackPanel
                            Margin="0,0,26,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="NEGOCIO ACTIVO"
                                Foreground="#64748B"
                                FontSize="9"
                                FontWeight="Bold"
                                HorizontalAlignment="Right"/>

                            <TextBlock
                                x:Name="txtNombreNegocio"
                                Text="Ferretería"
                                Foreground="White"
                                FontSize="14"
                                FontWeight="SemiBold"/>

                        </StackPanel>


                        <Border
                            Width="1"
                            Height="38"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,0,26,0"/>


                        <!-- FECHA SERVIDOR -->

                        <StackPanel
                            VerticalAlignment="Center">

                            <TextBlock
                                x:Name="txtFechaServidor"
                                Text="07 octubre 2026"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="11"
                                HorizontalAlignment="Right"/>

                            <TextBlock
                                x:Name="txtHoraServidor"
                                Text="09:45:21"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- AQUÍ SE CARGAN LOS USERCONTROL -->

            <ContentControl
                x:Name="MainContent"
                Grid.Row="1"
                Margin="24"/>

        </Grid>

    </Grid>

</Window>