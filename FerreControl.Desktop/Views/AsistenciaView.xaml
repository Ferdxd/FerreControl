<UserControl x:Class="FerreControl.Desktop.Views.AsistenciaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- CABECERA: títulos y acciones independientes para evitar saturación -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Asistencia" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="Consulta jornadas, puntualidad, descansos y tiempo trabajado."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <WrapPanel Grid.Row="1" Margin="0,16,0,0" Orientation="Horizontal">
                <Button x:Name="btnRegistrarManual"
                        Content="+  Registro manual"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Registrar una asistencia manualmente"
                        Margin="0,0,10,8"
                        Click="BtnRegistrarManual_Click"/>

                <Button x:Name="btnVerMarcaciones"
                        Content="Ver marcaciones"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Consultar las marcaciones del empleado seleccionado"
                        Margin="0,0,10,8"
                        IsEnabled="False"
                        Click="BtnVerMarcaciones_Click"/>

                <!-- Se declara el control sin Click explícito para que
                     el code-behind existente pueda enlazarlo sin requerir
                     un método de evento nuevo. -->
                <Button x:Name="btnExportarAsistencia"
                        Content="Exportar asistencia"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Exportar los registros de asistencia"
                        Margin="0,0,10,8"/>

                <Button x:Name="btnActualizarAsistencia"
                        Content="Actualizar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Actualizar los registros mostrados"
                        Margin="0,0,0,8"
                        Click="BtnActualizarAsistencia_Click"/>
            </WrapPanel>
        </Grid>


        <!-- ====================================================== -->
        <!-- INDICADORES                                            -->
        <!-- ====================================================== -->

        <Grid
            Grid.Row="1"
            Margin="0,12,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="PRESENTES"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtPresentes"
                        Text="--"
                        Foreground="{StaticResource SuccessBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="LLEGADAS TARDE"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtLlegadasTarde"
                        Text="--"
                        Foreground="{StaticResource WarningBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <Border
                Grid.Column="4"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="AUSENTES"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtAusentes"
                        Text="--"
                        Foreground="{StaticResource DangerBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <Border
                Grid.Column="6"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="TRABAJANDO"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtTrabajando"
                        Text="--"
                        Foreground="{StaticResource AccentLightBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <Border
                Grid.Column="8"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="SIN SALIDA"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtSinSalida"
                        Text="--"
                        Foreground="{StaticResource WarningBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ====================================================== -->
        <!-- FILTROS                                                -->
        <!-- ====================================================== -->

        <Border
            Grid.Row="2"
            Style="{StaticResource CardStyle}"
            Margin="0,18,0,0">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="210"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="190"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="Fecha"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="11"
                        Margin="0,0,0,5"/>


                    <DatePicker
                        x:Name="dpFechaAsistencia"
                        Style="{StaticResource ModernDatePickerStyle}"
                        SelectedDateFormat="Short"
                        SelectedDateChanged="DpFechaAsistencia_SelectedDateChanged"/>

                </StackPanel>


                <StackPanel Grid.Column="2">

                    <TextBlock
                        Text="Buscar empleado"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="11"
                        Margin="0,0,0,5"/>


                    <TextBox
                        x:Name="txtBuscarAsistencia"
                        Style="{StaticResource ModernTextBoxStyle}"
                        ToolTip="Buscar por nombre o código de empleado"
                        TextChanged="TxtBuscarAsistencia_TextChanged"/>

                </StackPanel>


                <StackPanel Grid.Column="4">

                    <TextBlock
                        Text="Estado"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="11"
                        Margin="0,0,0,5"/>


                    <ComboBox
                        x:Name="cmbEstadoAsistencia"
                        Style="{StaticResource ModernComboBoxStyle}"
                        SelectionChanged="CmbEstadoAsistencia_SelectionChanged">

                        <ComboBoxItem Content="Todos"/>

                        <ComboBoxItem Content="Puntual"/>

                        <ComboBoxItem Content="Tarde"/>

                        <ComboBoxItem Content="Ausente"/>

                        <ComboBoxItem Content="Trabajando"/>

                        <ComboBoxItem Content="En descanso"/>

                        <ComboBoxItem Content="Finalizado"/>

                        <ComboBoxItem Content="Incompleto"/>

                        <ComboBoxItem Content="Pendiente"/>

                        <ComboBoxItem Content="No laboral"/>

                        <ComboBoxItem Content="Sin horario"/>

                    </ComboBox>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ====================================================== -->
        <!-- CONTENIDO                                              -->
        <!-- ====================================================== -->

        <Grid
            Grid.Row="3"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" MinWidth="410"/>

                <ColumnDefinition Width="16"/>

                <ColumnDefinition Width="320"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================== -->
            <!-- TABLA                                              -->
            <!-- ================================================== -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <Grid Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="Control diario"
                                Style="{StaticResource SectionTitleStyle}"/>


                            <TextBlock
                                Text="Comparación entre el horario programado y las marcaciones reales."
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="12"
                                Margin="0,4,0,0"/>

                        </StackPanel>


                        <TextBlock
                            Grid.Column="1"
                            x:Name="txtFechaResumen"
                            Text="--"
                            Foreground="{StaticResource AccentLightBrush}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                    </Grid>


                    <DataGrid
                        x:Name="dgAsistencia"
                        Grid.Row="1"
                        Style="{StaticResource DarkDataGridStyle}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="True"
                        HeadersVisibility="Column"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        EnableRowVirtualization="True"
                        SelectionChanged="DgAsistencia_SelectionChanged"
                        MouseDoubleClick="DgAsistencia_MouseDoubleClick">

                        <DataGrid.Columns>


                            <DataGridTextColumn
                                Header="Código"
                                Binding="{Binding CodigoEmpleado}"
                                Width="80"/>


                            <DataGridTextColumn
                                Header="Empleado"
                                Binding="{Binding NombreEmpleado}"
                                Width="190"
                                MinWidth="140"/>


                            <DataGridTextColumn
                                Header="Horario"
                                Binding="{Binding Horario}"
                                Width="150"/>


                            <DataGridTextColumn
                                Header="Entrada"
                                Binding="{Binding HoraEntrada,
                                StringFormat={}{0:HH:mm},
                                TargetNullValue=--}"
                                Width="70"/>


                            <DataGridTextColumn
                                Header="Sale descanso"
                                Binding="{Binding HoraInicioDescanso,
                                StringFormat={}{0:HH:mm},
                                TargetNullValue=--}"
                                Width="95"/>


                            <DataGridTextColumn
                                Header="Regresa"
                                Binding="{Binding HoraFinDescanso,
                                StringFormat={}{0:HH:mm},
                                TargetNullValue=--}"
                                Width="75"/>


                            <DataGridTextColumn
                                Header="Salida"
                                Binding="{Binding HoraSalida,
                                StringFormat={}{0:HH:mm},
                                TargetNullValue=--}"
                                Width="70"/>


                            <DataGridTextColumn
                                Header="Tarde"
                                Binding="{Binding TardanzaTexto}"
                                Width="65"/>


                            <DataGridTextColumn
                                Header="Trabajado"
                                Binding="{Binding HorasTrabajadas}"
                                Width="78"/>


                            <DataGridTextColumn
                                Header="Faltante"
                                Binding="{Binding TiempoFaltante}"
                                Width="75"/>


                            <DataGridTextColumn
                                Header="Extra*"
                                Binding="{Binding TiempoExtra}"
                                Width="70"/>


                            <DataGridTextColumn
                                Header="Estado"
                                Binding="{Binding EstadoAsistencia}"
                                Width="105"/>


                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- DETALLE                                            -->
            <!-- ================================================== -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <StackPanel>

                        <TextBlock
                            Text="Detalle de asistencia"
                            Style="{StaticResource SectionTitleStyle}"/>


                        <TextBlock
                            x:Name="txtEmpleadoSeleccionado"
                            Text="Selecciona un empleado"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="12"
                            Margin="0,5,0,0"/>

                    </StackPanel>


                    <Border
                        Grid.Row="1"
                        Height="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,16,0,14"/>


                    <Border
                        Grid.Row="2"
                        Background="#0D1626"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,18">

                        <StackPanel>


                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Entrada"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock
                                    x:Name="txtDetalleEntrada"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <Grid Margin="0,10,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Salida a descanso"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock
                                    x:Name="txtDetalleInicioDescanso"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <Grid Margin="0,10,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Regreso descanso"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock
                                    x:Name="txtDetalleFinDescanso"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <Grid Margin="0,10,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Salida"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock
                                    x:Name="txtDetalleSalida"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <Border
                                Height="1"
                                Background="{StaticResource BorderBrush}"
                                Margin="0,14"/>


                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Trabajado"
                                    Foreground="{StaticResource AccentLightBrush}"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    x:Name="txtDetalleHoras"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <Grid Margin="0,10,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Faltante"
                                    Foreground="{StaticResource WarningBrush}"/>

                                <TextBlock
                                    x:Name="txtDetalleFaltante"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <Grid Margin="0,10,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Extra candidato"
                                    Foreground="{StaticResource SuccessBrush}"/>

                                <TextBlock
                                    x:Name="txtDetalleExtra"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <Grid Grid.Row="3">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="Marcaciones del día"
                            Foreground="White"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,0,10"/>


                        <ListBox
                            x:Name="lstMarcacionesRecientes"
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Background="#0D1626"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="11"
                                        Margin="0,0,0,8">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>


                                            <StackPanel>

                                                <TextBlock
                                                    Text="{Binding TipoMarcacionTexto}"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    FontSize="12"/>


                                                <TextBlock
                                                    Text="{Binding MetodoMarcacionTexto}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="10"
                                                    Margin="0,3,0,0"/>

                                            </StackPanel>


                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding FechaHora,
                                                StringFormat=HH:mm:ss}"
                                                Foreground="{StaticResource AccentLightBrush}"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>