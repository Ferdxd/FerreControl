<UserControl x:Class="FerreControl.Desktop.Views.AsistenciaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- CABECERA                                               -->
        <!-- ====================================================== -->

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="Asistencia"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Control diario de entradas, descansos, salidas y jornada laboral."
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="13"
                    Margin="0,6,0,0"/>

            </StackPanel>


            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal">


                <Button
                    x:Name="btnRegistrarManual"
                    Content="+  Registrar manual"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="BtnRegistrarManual_Click"/>


                <Button
                    x:Name="btnVerMarcaciones"
                    Content="Ver marcaciones"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    IsEnabled="False"
                    Click="BtnVerMarcaciones_Click"/>


                <Button
                    x:Name="btnActualizarAsistencia"
                    Content="Actualizar"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="BtnActualizarAsistencia_Click"/>


                <Button
                    x:Name="btnExportarAsistencia"
                    Content="Exportar reporte"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False"/>

            </StackPanel>

        </Grid>


        <!-- ====================================================== -->
        <!-- INDICADORES                                            -->
        <!-- ====================================================== -->

        <Grid
            Grid.Row="1"
            Margin="0,22,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- PRESENTES -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="PRESENTES"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="txtPresentes"
                        Text="--"
                        Foreground="{StaticResource SuccessBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- TARDE -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="LLEGADAS TARDE"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="txtLlegadasTarde"
                        Text="--"
                        Foreground="{StaticResource WarningBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- AUSENTES -->

            <Border
                Grid.Column="4"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="AUSENTES"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="txtAusentes"
                        Text="--"
                        Foreground="{StaticResource DangerBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- TRABAJANDO -->

            <Border
                Grid.Column="6"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="TRABAJANDO"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="txtTrabajando"
                        Text="--"
                        Foreground="{StaticResource AccentLightBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- SIN SALIDA -->

            <Border
                Grid.Column="8"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="SIN SALIDA"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="txtSinSalida"
                        Text="--"
                        Foreground="{StaticResource WarningBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ====================================================== -->
        <!-- FILTROS                                                -->
        <!-- ====================================================== -->

        <Border
            Grid.Row="2"
            Style="{StaticResource CardStyle}"
            Margin="0,18,0,0">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="210"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="190"/>

                </Grid.ColumnDefinitions>


                <!-- FECHA -->

                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="Fecha"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="11"
                        Margin="0,0,0,5"/>


                    <DatePicker
                        x:Name="dpFechaAsistencia"
                        Style="{StaticResource ModernDatePickerStyle}"
                        SelectedDateFormat="Short"
                        SelectedDateChanged="DpFechaAsistencia_SelectedDateChanged"/>

                </StackPanel>


                <!-- BUSCAR -->

                <StackPanel Grid.Column="2">

                    <TextBlock
                        Text="Buscar empleado"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="11"
                        Margin="0,0,0,5"/>


                    <TextBox
                        x:Name="txtBuscarAsistencia"
                        Style="{StaticResource ModernTextBoxStyle}"
                        TextChanged="TxtBuscarAsistencia_TextChanged"/>

                </StackPanel>


                <!-- ESTADO -->

                <StackPanel Grid.Column="4">

                    <TextBlock
                        Text="Estado"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="11"
                        Margin="0,0,0,5"/>


                    <ComboBox
                        x:Name="cmbEstadoAsistencia"
                        Style="{StaticResource ModernComboBoxStyle}"
                        SelectionChanged="CmbEstadoAsistencia_SelectionChanged">

                        <ComboBoxItem Content="Todos"/>

                        <ComboBoxItem Content="Puntual"/>

                        <ComboBoxItem Content="Tarde"/>

                        <ComboBoxItem Content="Ausente"/>

                        <ComboBoxItem Content="Trabajando"/>

                        <ComboBoxItem Content="En descanso"/>

                        <ComboBoxItem Content="Finalizado"/>

                        <ComboBoxItem Content="Incompleto"/>

                    </ComboBox>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ====================================================== -->
        <!-- CONTENIDO                                              -->
        <!-- ====================================================== -->

        <Grid
            Grid.Row="3"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="3*"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================== -->
            <!-- CONTROL DIARIO                                     -->
            <!-- ================================================== -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <Grid Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="Control diario"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Jornada real registrada para cada empleado."
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="12"
                                Margin="0,4,0,0"/>

                        </StackPanel>


                        <TextBlock
                            Grid.Column="1"
                            x:Name="txtFechaResumen"
                            Text="--"
                            Foreground="{StaticResource AccentLightBrush}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                    </Grid>


                    <!-- TABLA -->

                    <DataGrid
                        x:Name="dgAsistencia"
                        Grid.Row="1"
                        Style="{StaticResource DarkDataGridStyle}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        SelectionChanged="DgAsistencia_SelectionChanged"
                        MouseDoubleClick="DgAsistencia_MouseDoubleClick">

                        <DataGrid.Columns>


                            <DataGridTextColumn
                                Header="Código"
                                Binding="{Binding CodigoEmpleado}"
                                Width="90"/>


                            <DataGridTextColumn
                                Header="Empleado"
                                Binding="{Binding NombreEmpleado}"
                                Width="*"
                                MinWidth="150"/>


                            <DataGridTextColumn
                                Header="Horario"
                                Binding="{Binding Horario}"
                                Width="120"/>


                            <DataGridTextColumn
                                Header="Entrada"
                                Binding="{Binding HoraEntrada}"
                                Width="78"/>


                            <DataGridTextColumn
                                Header="Sale descanso"
                                Binding="{Binding HoraInicioDescanso}"
                                Width="100"/>


                            <DataGridTextColumn
                                Header="Regresa"
                                Binding="{Binding HoraFinDescanso}"
                                Width="82"/>


                            <DataGridTextColumn
                                Header="Salida"
                                Binding="{Binding HoraSalida}"
                                Width="78"/>


                            <DataGridTextColumn
                                Header="Tarde"
                                Binding="{Binding MinutosTarde}"
                                Width="65"/>


                            <DataGridTextColumn
                                Header="Trabajado"
                                Binding="{Binding HorasTrabajadas}"
                                Width="85"/>


                            <DataGridTextColumn
                                Header="Estado"
                                Binding="{Binding EstadoAsistencia}"
                                Width="100"/>


                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- PANEL DERECHO                                      -->
            <!-- ================================================== -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- EMPLEADO SELECCIONADO -->

                    <StackPanel>

                        <TextBlock
                            Text="Detalle de asistencia"
                            Style="{StaticResource SectionTitleStyle}"/>


                        <TextBlock
                            x:Name="txtEmpleadoSeleccionado"
                            Text="Selecciona un empleado"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="12"
                            Margin="0,5,0,0"/>

                    </StackPanel>


                    <Border
                        Grid.Row="1"
                        Height="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,16,0,14"/>


                    <!-- RESUMEN DEL EMPLEADO -->

                    <Border
                        Grid.Row="2"
                        Background="#0D1626"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,0,18">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <!-- ENTRADA -->

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Text="Entrada"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>


                                <TextBlock
                                    x:Name="txtDetalleEntrada"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <!-- SALIDA DESCANSO -->

                            <Grid
                                Grid.Row="1"
                                Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Text="Salida a descanso"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>


                                <TextBlock
                                    x:Name="txtDetalleInicioDescanso"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <!-- REGRESO DESCANSO -->

                            <Grid
                                Grid.Row="2"
                                Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Text="Regreso de descanso"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>


                                <TextBlock
                                    x:Name="txtDetalleFinDescanso"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <!-- SALIDA FINAL -->

                            <Grid
                                Grid.Row="3"
                                Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Text="Salida"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>


                                <TextBlock
                                    x:Name="txtDetalleSalida"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>


                            <!-- TOTAL -->

                            <Grid
                                Grid.Row="4"
                                Margin="0,15,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Text="Tiempo trabajado"
                                    Foreground="{StaticResource AccentLightBrush}"
                                    FontWeight="SemiBold"/>


                                <TextBlock
                                    x:Name="txtDetalleHoras"
                                    Grid.Column="1"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"/>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- MARCACIONES RECIENTES -->

                    <Grid Grid.Row="3">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="Marcaciones del día"
                            Foreground="White"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,0,10"/>


                        <ListBox
                            x:Name="lstMarcacionesRecientes"
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Background="#0D1626"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="11"
                                        Margin="0,0,0,8">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>


                                            <StackPanel>

                                                <TextBlock
                                                    Text="{Binding NombreEmpleado}"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    FontSize="12"/>


                                                <TextBlock
                                                    Text="{Binding TipoMarcacion}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="10"
                                                    Margin="0,3,0,0"/>

                                            </StackPanel>


                                            <StackPanel
                                                Grid.Column="1"
                                                HorizontalAlignment="Right">

                                                <TextBlock
                                                    Text="{Binding FechaHora,
                                                    StringFormat=HH:mm}"
                                                    Foreground="{StaticResource AccentLightBrush}"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Right"/>


                                                <TextBlock
                                                    Text="{Binding MetodoMarcacion}"
                                                    Foreground="#64748B"
                                                    FontSize="9"
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Right"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>