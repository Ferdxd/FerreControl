<UserControl x:Class="FerreControl.Desktop.Views.NominaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- CABECERA                                              -->
        <!-- ===================================================== -->

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="Nómina"
                    Style="{StaticResource PageTitleStyle}"/>


                <TextBlock
                    Text="Administra períodos, adelantos y pagos de empleados."
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="13"
                    Margin="0,6,0,0"/>

            </StackPanel>


            <Button
                x:Name="btnNuevaNomina"
                Grid.Column="1"
                Content="+  Nueva nómina"
                Style="{StaticResource PrimaryButtonStyle}"
                Height="42"
                Click="BtnNuevaNomina_Click"/>

        </Grid>


        <!-- ===================================================== -->
        <!-- INDICADORES                                           -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="1"
            Margin="0,22,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="14"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="14"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- TOTAL NÓMINA -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="TOTAL NÓMINA"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtTotalNomina"
                        Text="Q 0.00"
                        Foreground="White"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- PAGADO -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="PAGADO"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtTotalPagado"
                        Text="Q 0.00"
                        Foreground="{StaticResource SuccessBrush}"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- PENDIENTE -->

            <Border
                Grid.Column="4"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="PENDIENTE"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtTotalPendiente"
                        Text="Q 0.00"
                        Foreground="{StaticResource WarningBrush}"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- FILTROS                                               -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="2"
            Style="{StaticResource CardStyle}"
            Margin="0,18,0,0">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="190"/>

                </Grid.ColumnDefinitions>


                <TextBox
                    x:Name="txtBuscarNomina"
                    Style="{StaticResource ModernTextBoxStyle}"
                    Margin="0,0,15,0"
                    TextChanged="TxtBuscarNomina_TextChanged"/>


                <ComboBox
                    x:Name="cmbEstadoNomina"
                    Grid.Column="1"
                    Style="{StaticResource ModernComboBoxStyle}"
                    SelectionChanged="CmbEstadoNomina_SelectionChanged">

                    <ComboBoxItem Content="Todos"/>

                    <ComboBoxItem Content="BORRADOR"/>

                    <ComboBoxItem Content="GENERADA"/>

                    <ComboBoxItem Content="CERRADA"/>

                </ComboBox>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- CONTENIDO                                             -->
        <!-- ===================================================== -->

        <Grid
            Grid.Row="3"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="310"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LISTADO NÓMINAS                                   -->
            <!-- ================================================= -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <TextBlock
                        Text="Períodos de nómina"
                        Style="{StaticResource SectionTitleStyle}"
                        Margin="0,0,0,15"/>


                    <ListBox
                        x:Name="lstNominas"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        SelectionChanged="LstNominas_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Background="#0D1626"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,8">

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Text="{Binding Estado}"
                                            Foreground="{StaticResource AccentLightBrush}"
                                            FontWeight="SemiBold"
                                            FontSize="13"/>


                                        <StackPanel
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            Margin="0,7,0,0">

                                            <TextBlock
                                                Text="{Binding FechaInicioPeriodo,
                                                StringFormat=dd/MM/yyyy}"
                                                Foreground="White"/>


                                            <TextBlock
                                                Text="  →  "
                                                Foreground="{StaticResource TextSecondaryBrush}"/>


                                            <TextBlock
                                                Text="{Binding FechaFinPeriodo,
                                                StringFormat=dd/MM/yyyy}"
                                                Foreground="White"/>

                                        </StackPanel>


                                        <TextBlock
                                            Grid.Row="2"
                                            Text="{Binding FechaGeneracion,
                                            StringFormat='Creada dd/MM/yyyy'}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            FontSize="11"
                                            Margin="0,6,0,0"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- DETALLE NÓMINA                                    -->
            <!-- ================================================= -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ========================================= -->
                    <!-- CABECERA DEL DETALLE                      -->
                    <!-- ========================================= -->




                    <!-- ========================================= -->
                    <!-- CABECERA DEL DETALLE                      -->
                    <!-- ========================================= -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="20"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- TÍTULO -->

                        <StackPanel Grid.Column="0">

                            <TextBlock
            x:Name="txtPeriodoSeleccionado"
            Text="Selecciona una nómina"
            Style="{StaticResource SectionTitleStyle}"/>


                            <TextBlock
            x:Name="txtEstadoSeleccionado"
            Text="--"
            Foreground="{StaticResource TextSecondaryBrush}"
            FontSize="12"
            Margin="0,4,0,0"/>

                        </StackPanel>


                        <!-- ACCIONES -->

                        <WrapPanel
        Grid.Column="2"
        HorizontalAlignment="Right"
        VerticalAlignment="Center">


                            <Button
            x:Name="btnAgregarEmpleado"
            Content="+ Empleado"
            Style="{StaticResource SecondaryButtonStyle}"
            IsEnabled="False"
            Margin="0,0,8,8"
            Click="BtnAgregarEmpleado_Click"/>


                            <Button
            x:Name="btnDarAdelanto"
            Content="Adelantos"
            Style="{StaticResource PrimaryButtonStyle}"
            IsEnabled="False"
            Margin="0,0,8,8"
            Click="BtnDarAdelanto_Click"/>

            <Button
            x:Name="btnHistorialAdelantos"
            Content="Historial adelantos"
            Style="{StaticResource SecondaryButtonStyle}"
            IsEnabled="False"
            Margin="0,0,8,8"
            Click="BtnHistorialAdelantos_Click"/>


                            <Button
            x:Name="btnGenerarNomina"
            Content="Generar"
            Style="{StaticResource SecondaryButtonStyle}"
            IsEnabled="False"
            Margin="0,0,8,8"
            Click="BtnGenerarNomina_Click"/>


                            <Button
            x:Name="btnRegistrarPago"
            Content="Registrar pago"
            Style="{StaticResource PrimaryButtonStyle}"
            IsEnabled="False"
            Margin="0,0,8,8"
            Click="BtnRegistrarPago_Click"/>


                            <Button
            x:Name="btnVerPagos"
            Content="Ver pagos"
            Style="{StaticResource SecondaryButtonStyle}"
            IsEnabled="False"
            Margin="0,0,8,8"
            Click="BtnVerPagos_Click"/>


                            <Button
            x:Name="btnCerrarNomina"
            Content="Cerrar"
            Style="{StaticResource SecondaryButtonStyle}"
            IsEnabled="False"
            Margin="0,0,0,8"
            Click="BtnCerrarNomina_Click"/>

                        </WrapPanel>

                    </Grid>


                    <!-- ========================================= -->
                    <!-- RESUMEN DEL PERÍODO                       -->
                    <!-- ========================================= -->

                    <Border
                        Grid.Row="1"
                        Background="#0D1626"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,18,0,18">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="EMPLEADOS"
                                    Foreground="#64748B"
                                    FontSize="10"/>


                                <TextBlock
                                    x:Name="txtCantidadEmpleados"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1">

                                <TextBlock
                                    Text="INICIO"
                                    Foreground="#64748B"
                                    FontSize="10"/>


                                <TextBlock
                                    x:Name="txtFechaInicio"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock
                                    Text="FIN"
                                    Foreground="#64748B"
                                    FontSize="10"/>


                                <TextBlock
                                    x:Name="txtFechaFin"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- ========================================= -->
                    <!-- DETALLE EMPLEADOS                         -->
                    <!-- ========================================= -->

                    <DataGrid
                        x:Name="dgNominaDetalle"
                        Grid.Row="2"
                        Style="{StaticResource DarkDataGridStyle}"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        SelectionChanged="DgNominaDetalle_SelectionChanged">

                        <DataGrid.Columns>


                            <DataGridTextColumn
                                Header="Código"
                                Binding="{Binding CodigoEmpleado}"
                                Width="80"/>


                            <DataGridTextColumn
                                Header="Empleado"
                                Binding="{Binding Empleado}"
                                Width="*"/>


                            <DataGridTextColumn
                                Header="Salario"
                                Binding="{Binding SalarioBase,
                                StringFormat='Q {0:N2}'}"
                                Width="100"/>


                            <DataGridTextColumn
                                Header="Bonos"
                                Binding="{Binding Bonificaciones,
                                StringFormat='Q {0:N2}'}"
                                Width="90"/>


                            <DataGridTextColumn
                                Header="Extra"
                                Binding="{Binding HorasExtra,
                                StringFormat='Q {0:N2}'}"
                                Width="90"/>


                            <DataGridTextColumn
                                Header="Adelantos"
                                Binding="{Binding Adelantos,
                                StringFormat='Q {0:N2}'}"
                                Width="100"/>


                            <DataGridTextColumn
                                Header="Otros desc."
                                Binding="{Binding OtrosDescuentos,
                                StringFormat='Q {0:N2}'}"
                                Width="105"/>


                            <DataGridTextColumn
                                Header="Total"
                                Binding="{Binding TotalPagar,
                                StringFormat='Q {0:N2}'}"
                                Width="100"/>


                            <DataGridTextColumn
                                Header="Pagado"
                                Binding="{Binding TotalPagado,
                                StringFormat='Q {0:N2}'}"
                                Width="100"/>


                            <DataGridTextColumn
                                Header="Pendiente"
                                Binding="{Binding Pendiente,
                                StringFormat='Q {0:N2}'}"
                                Width="105"/>


                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>