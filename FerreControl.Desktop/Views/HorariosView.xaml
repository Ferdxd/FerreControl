<UserControl x:Class="FerreControl.Desktop.Views.HorariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- CABECERA -->

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="Horarios"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Configura jornadas laborales, tolerancias y días de descanso."
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="13"
                    Margin="0,6,0,0"/>

            </StackPanel>


            <Button
                x:Name="btnNuevoHorario"
                Grid.Column="1"
                Content="+  Nuevo horario"
                Style="{StaticResource PrimaryButtonStyle}"
                Height="42"
                Click="BtnNuevoHorario_Click"/>

        </Grid>


        <!-- RESUMEN -->

        <Grid
            Grid.Row="1"
            Margin="0,22,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="14"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="14"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="HORARIOS ACTIVOS"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="txtHorariosActivos"
                        Text="--"
                        Foreground="White"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="EMPLEADOS ASIGNADOS"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>

                    <TextBlock
                        x:Name="txtEmpleadosAsignados"
                        Text="--"
                        Foreground="{StaticResource AccentLightBrush}"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <Border
                Grid.Column="4"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="TOLERANCIA PROMEDIO"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>

                    <StackPanel
                        Orientation="Horizontal">

                        <TextBlock
                            x:Name="txtToleranciaPromedio"
                            Text="--"
                            Foreground="{StaticResource WarningBrush}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Margin="0,6,5,0"/>

                        <TextBlock
                            Text="min"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,5"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>


        <!-- CONTENIDO -->

        <Grid
            Grid.Row="2"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="320"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- LISTA DE HORARIOS -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <TextBlock
                        Text="Horarios registrados"
                        Style="{StaticResource SectionTitleStyle}"/>


                    <TextBox
                        Grid.Row="1"
                        x:Name="txtBuscarHorario"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Margin="0,16,0,14"
                        TextChanged="TxtBuscarHorario_TextChanged"/>


                    <ListBox
                        x:Name="lstHorarios"
                        Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        SelectionChanged="LstHorarios_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Background="#0D1626"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,8">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>


                                        <StackPanel>

                                            <TextBlock
                                                Text="{Binding Nombre}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                FontSize="14"/>


                                            <StackPanel
                                                Orientation="Horizontal"
                                                Margin="0,6,0,0">

                                                <TextBlock
                                                    Text="Tolerancia: "
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="11"/>

                                                <TextBlock
                                                    Text="{Binding ToleranciaMinutos}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="11"/>

                                                <TextBlock
                                                    Text=" min"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="11"/>

                                            </StackPanel>

                                        </StackPanel>


                                        <Ellipse
                                            Grid.Column="1"
                                            Width="8"
                                            Height="8"
                                            Fill="{StaticResource SuccessBrush}"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>


            <!-- DETALLE -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ENCABEZADO -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                x:Name="txtNombreHorarioSeleccionado"
                                Text="Detalle del horario"
                                Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Configuración semanal"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="12"
                                Margin="0,4,0,0"/>

                        </StackPanel>


                        <Button
                            x:Name="btnEditarHorario"
                            Grid.Column="1"
                            Content="Editar horario"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="BtnEditarHorario_Click"/>

                    </Grid>


                    <!-- DATOS GENERALES -->

                    <Border
                        Grid.Row="1"
                        Background="#0D1626"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,18,0,18">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="Nombre"
                                    Foreground="#64748B"
                                    FontSize="10"/>

                                <TextBlock
                                    x:Name="txtNombreHorario"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1">

                                <TextBlock
                                    Text="Tolerancia"
                                    Foreground="#64748B"
                                    FontSize="10"/>

                                <TextBlock
                                    x:Name="txtToleranciaHorario"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock
                                    Text="Estado"
                                    Foreground="#64748B"
                                    FontSize="10"/>

                                <TextBlock
                                    x:Name="txtEstadoHorario"
                                    Text="--"
                                    Foreground="{StaticResource SuccessBrush}"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- SEMANA -->

                    <DataGrid
                        x:Name="dgHorarioDetalle"
                        Grid.Row="2"
                        Style="{StaticResource DarkDataGridStyle}"
                        IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Día"
                                Binding="{Binding Dia}"
                                Width="*"/>

                            <DataGridCheckBoxColumn
                                Header="Laboral"
                                Binding="{Binding EsLaboral, Mode=OneWay}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="Entrada"
                                Binding="{Binding Entrada}"
                                Width="120"/>

                            <DataGridTextColumn
                                Header="Salida"
                                Binding="{Binding Salida}"
                                Width="120"/>

                            <DataGridTextColumn
                                Header="Descanso"
                                Binding="{Binding MinutosDescanso}"
                                Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>