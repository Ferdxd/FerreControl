<UserControl x:Class="FerreControl.Desktop.Views.HorariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- CABECERA                                               -->
        <!-- ====================================================== -->

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="Horarios"
                    Style="{StaticResource PageTitleStyle}"/>


                <TextBlock
                    Text="Configura jornadas laborales y asigna los horarios a los empleados."
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="13"
                    Margin="0,6,0,0"/>

            </StackPanel>


            <Button
                x:Name="btnNuevoHorario"
                Grid.Column="1"
                Content="+  Nuevo horario"
                Style="{StaticResource PrimaryButtonStyle}"
                Height="42"
                Click="BtnNuevoHorario_Click"/>

        </Grid>


        <!-- ====================================================== -->
        <!-- RESUMEN                                                -->
        <!-- ====================================================== -->

        <Grid
            Grid.Row="1"
            Margin="0,22,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- HORARIOS ACTIVOS -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="HORARIOS ACTIVOS"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtHorariosActivos"
                        Text="--"
                        Foreground="White"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- EMPLEADOS ASIGNADOS -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="CON HORARIO"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtEmpleadosAsignados"
                        Text="--"
                        Foreground="{StaticResource SuccessBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- SIN HORARIO -->

            <Border
                Grid.Column="4"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="SIN HORARIO"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <TextBlock
                        x:Name="txtEmpleadosSinHorario"
                        Text="--"
                        Foreground="{StaticResource WarningBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,6,0,0"/>

                </StackPanel>

            </Border>


            <!-- TOLERANCIA -->

            <Border
                Grid.Column="6"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="TOLERANCIA PROMEDIO"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"/>


                    <StackPanel
                        Orientation="Horizontal">

                        <TextBlock
                            x:Name="txtToleranciaPromedio"
                            Text="--"
                            Foreground="{StaticResource AccentLightBrush}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Margin="0,6,5,0"/>


                        <TextBlock
                            Text="min"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,5"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ====================================================== -->
        <!-- CONTENIDO                                              -->
        <!-- ====================================================== -->

        <Grid
            Grid.Row="2"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="300"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================== -->
            <!-- LISTADO DE HORARIOS                                -->
            <!-- ================================================== -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <TextBlock
                        Text="Horarios registrados"
                        Style="{StaticResource SectionTitleStyle}"/>


                    <TextBox
                        Grid.Row="1"
                        x:Name="txtBuscarHorario"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Margin="0,16,0,14"
                        TextChanged="TxtBuscarHorario_TextChanged"/>


                    <ListBox
                        x:Name="lstHorarios"
                        Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        SelectionChanged="LstHorarios_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Background="#0D1626"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,8">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>


                                        <StackPanel>

                                            <TextBlock
                                                Text="{Binding Nombre}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                FontSize="14"/>


                                            <StackPanel
                                                Orientation="Horizontal"
                                                Margin="0,6,0,0">

                                                <TextBlock
                                                    Text="Tolerancia: "
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="11"/>


                                                <TextBlock
                                                    Text="{Binding ToleranciaMinutos}"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="11"/>


                                                <TextBlock
                                                    Text=" min"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    FontSize="11"/>

                                            </StackPanel>

                                        </StackPanel>


                                        <Ellipse
                                            Grid.Column="1"
                                            Width="8"
                                            Height="8"
                                            Fill="{StaticResource SuccessBrush}"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- DETALLE                                            -->
            <!-- ================================================== -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="18"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ========================================= -->
                    <!-- ENCABEZADO                                -->
                    <!-- ========================================= -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                x:Name="txtNombreHorarioSeleccionado"
                                Text="Detalle del horario"
                                Style="{StaticResource SectionTitleStyle}"/>


                            <TextBlock
                                Text="Configuración semanal y empleados asignados"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="12"
                                Margin="0,4,0,0"/>

                        </StackPanel>


                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal">


                            <Button
                                x:Name="btnAsignarEmpleado"
                                Content="+ Asignar empleado"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                Margin="0,0,10,0"
                                Click="BtnAsignarEmpleado_Click"/>


                            <Button
                                x:Name="btnEditarHorario"
                                Content="Editar horario"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Click="BtnEditarHorario_Click"/>

                        </StackPanel>

                    </Grid>


                    <!-- ========================================= -->
                    <!-- DATOS GENERALES                           -->
                    <!-- ========================================= -->

                    <Border
                        Grid.Row="1"
                        Background="#0D1626"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,18,0,18">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="NOMBRE"
                                    Foreground="#64748B"
                                    FontSize="10"/>


                                <TextBlock
                                    x:Name="txtNombreHorario"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Column="1">

                                <TextBlock
                                    Text="TOLERANCIA"
                                    Foreground="#64748B"
                                    FontSize="10"/>


                                <TextBlock
                                    x:Name="txtToleranciaHorario"
                                    Text="--"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock
                                    Text="EMPLEADOS"
                                    Foreground="#64748B"
                                    FontSize="10"/>


                                <TextBlock
                                    x:Name="txtEmpleadosHorario"
                                    Text="--"
                                    Foreground="{StaticResource AccentLightBrush}"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"/>

                            </StackPanel>


                            <StackPanel Grid.Column="3">

                                <TextBlock
                                    Text="ESTADO"
                                    Foreground="#64748B"
                                    FontSize="10"/>


                                <TextBlock
                                    x:Name="txtEstadoHorario"
                                    Text="--"
                                    Foreground="{StaticResource SuccessBrush}"
                                    FontWeight="SemiBold"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- ========================================= -->
                    <!-- CONFIGURACIÓN SEMANAL                     -->
                    <!-- ========================================= -->

                    <Grid Grid.Row="2">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <TextBlock
                            Text="Configuración semanal"
                            Foreground="White"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,0,10"/>


                        <DataGrid
                            x:Name="dgHorarioDetalle"
                            Grid.Row="1"
                            Style="{StaticResource DarkDataGridStyle}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True">

                            <DataGrid.Columns>


                                <DataGridTextColumn
                                    Header="Día"
                                    Binding="{Binding Dia}"
                                    Width="*"/>


                                <DataGridCheckBoxColumn
                                    Header="Laboral"
                                    Binding="{Binding EsLaboral,
                                    Mode=OneWay}"
                                    Width="80"/>


                                <DataGridTextColumn
                                    Header="Entrada"
                                    Binding="{Binding Entrada}"
                                    Width="100"/>


                                <DataGridTextColumn
                                    Header="Salida"
                                    Binding="{Binding Salida}"
                                    Width="100"/>


                                <DataGridTextColumn
                                    Header="Descanso"
                                    Binding="{Binding Descanso}"
                                    Width="100"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>


                    <!-- ========================================= -->
                    <!-- EMPLEADOS ASIGNADOS                       -->
                    <!-- ========================================= -->

                    <Grid Grid.Row="4">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock
                                Text="Empleados con este horario"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>


                            <TextBlock
                                x:Name="txtSinEmpleadosHorario"
                                Grid.Column="1"
                                Text=""
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="11"
                                VerticalAlignment="Center"/>

                        </Grid>


                        <DataGrid
                            x:Name="dgEmpleadosHorario"
                            Grid.Row="1"
                            Style="{StaticResource DarkDataGridStyle}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            Margin="0,10,0,0"
                            SelectionMode="Single"
                            SelectionUnit="FullRow">

                            <DataGrid.Columns>


                                <DataGridTextColumn
                                    Header="Código"
                                    Binding="{Binding Codigo}"
                                    Width="90"/>


                                <DataGridTextColumn
                                    Header="Empleado"
                                    Binding="{Binding Empleado}"
                                    Width="*"/>


                                <DataGridTextColumn
                                    Header="Puesto"
                                    Binding="{Binding Puesto}"
                                    Width="150"/>


                                <DataGridTextColumn
                                    Header="Asignado desde"
                                    Binding="{Binding FechaInicio,
                                    StringFormat=dd/MM/yyyy}"
                                    Width="120"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>