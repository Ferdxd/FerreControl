<Window x:Class="FerreControl.Desktop.Views.Forms.AsignarHorarioEmpleadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asignar horario"
        Width="620"
        Height="610"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- CABECERA                                              -->
        <!-- ===================================================== -->

        <StackPanel>

            <TextBlock
                Text="Asignar horario"
                Foreground="White"
                FontSize="24"
                FontWeight="SemiBold"/>


            <TextBlock
                Text="Asigna el horario seleccionado a un empleado."
                Foreground="{StaticResource TextSecondaryBrush}"
                FontSize="12"
                Margin="0,7,0,0"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- FORMULARIO                                            -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="1"
            Style="{StaticResource CardStyle}"
            Margin="0,22,0,22">

            <StackPanel>


                <!-- HORARIO -->

                <TextBlock
                    Text="HORARIO A ASIGNAR"
                    Foreground="#64748B"
                    FontSize="10"
                    FontWeight="Bold"/>


                <TextBlock
                    x:Name="txtHorario"
                    Text="--"
                    Foreground="{StaticResource AccentLightBrush}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Margin="0,5,0,20"/>


                <!-- EMPLEADO -->

                <TextBlock
                    Text="EMPLEADO"
                    Foreground="#64748B"
                    FontSize="10"
                    FontWeight="Bold"
                    Margin="0,0,0,7"/>


                <ComboBox
                    x:Name="cmbEmpleado"
                    Style="{StaticResource ModernComboBoxStyle}"
                    Margin="0,0,0,20"
                    SelectionChanged="CmbEmpleado_SelectionChanged">

                    <ComboBox.ItemTemplate>

                        <DataTemplate>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="90"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Text="{Binding Codigo}"
                                    Foreground="{StaticResource AccentLightBrush}"
                                    FontWeight="SemiBold"/>


                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal">

                                    <TextBlock
                                        Text="{Binding Nombres}"
                                        Foreground="White"/>

                                    <TextBlock
                                        Text=" "
                                        Foreground="White"/>

                                    <TextBlock
                                        Text="{Binding Apellidos}"
                                        Foreground="White"/>

                                </StackPanel>

                            </Grid>

                        </DataTemplate>

                    </ComboBox.ItemTemplate>

                </ComboBox>


                <!-- HORARIO ACTUAL -->

                <Border
                    Background="#0D1626"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,20">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="HORARIO ACTUAL"
                                Foreground="#64748B"
                                FontSize="10"
                                FontWeight="Bold"/>


                            <TextBlock
                                x:Name="txtHorarioActual"
                                Text="Seleccione un empleado"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"/>

                        </StackPanel>


                        <TextBlock
                            x:Name="txtFechaHorarioActual"
                            Grid.Column="1"
                            Text=""
                            Foreground="{StaticResource TextSecondaryBrush}"
                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- FECHA INICIO -->

                <TextBlock
                    Text="FECHA DE INICIO DEL NUEVO HORARIO"
                    Foreground="#64748B"
                    FontSize="10"
                    FontWeight="Bold"
                    Margin="0,0,0,7"/>


                <DatePicker
                    x:Name="dpFechaInicio"
                    Style="{StaticResource ModernDatePickerStyle}"
                    SelectedDateFormat="Short"
                    Margin="0,0,0,18"/>


                <!-- AVISO -->

                <Border
                    Background="#2A2111"
                    BorderBrush="#634B18"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="13">

                    <TextBlock
                        x:Name="txtAviso"
                        Text="Si el empleado ya tiene un horario, el horario actual se cerrará el día anterior a la nueva asignación. El historial no se elimina."
                        Foreground="#FBBF24"
                        FontSize="11"
                        TextWrapping="Wrap"/>

                </Border>


            </StackPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- BOTONES                                               -->
        <!-- ===================================================== -->

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Cancelar"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="0,0,12,0"
                Click="BtnCancelar_Click"/>


            <Button
                x:Name="btnAsignar"
                Content="Asignar horario"
                Style="{StaticResource PrimaryButtonStyle}"
                IsEnabled="False"
                Click="BtnAsignar_Click"/>

        </StackPanel>

    </Grid>

</Window>