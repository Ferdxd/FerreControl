<Window x:Class="FerreControl.Desktop.Views.Forms.AplicarAdelantoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aplicar adelanto"
        Width="620"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <StackPanel>

            <TextBlock
                Text="Aplicar adelanto"
                Foreground="White"
                FontSize="24"
                FontWeight="SemiBold"/>

            <TextBlock
                x:Name="txtEmpleado"
                Foreground="{StaticResource TextSecondaryBrush}"
                Margin="0,7,0,0"/>

        </StackPanel>


        <Border
            Grid.Row="1"
            Style="{StaticResource CardStyle}"
            Margin="0,22,0,22">

            <StackPanel>


                <TextBlock
                    Text="ADELANTO PENDIENTE"
                    Foreground="#64748B"
                    FontSize="10"
                    FontWeight="Bold"
                    Margin="0,0,0,7"/>


                <ComboBox
                    x:Name="cmbAdelanto"
                    Style="{StaticResource ModernComboBoxStyle}"
                    DisplayMemberPath="Descripcion"
                    SelectionChanged="CmbAdelanto_SelectionChanged"
                    Margin="0,0,0,20"/>


                <Border
                    Background="#0D1626"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,20">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="MONTO ORIGINAL"
                                Foreground="#64748B"
                                FontSize="10"/>

                            <TextBlock
                                x:Name="txtMontoOriginal"
                                Text="Q 0.00"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"/>

                        </StackPanel>


                        <StackPanel
                            Grid.Column="1">

                            <TextBlock
                                Text="SALDO PENDIENTE"
                                Foreground="#64748B"
                                FontSize="10"/>

                            <TextBlock
                                x:Name="txtSaldo"
                                Text="Q 0.00"
                                Foreground="{StaticResource WarningBrush}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <TextBlock
                    Text="MONTO A DESCONTAR EN ESTA NÓMINA"
                    Foreground="#64748B"
                    FontSize="10"
                    FontWeight="Bold"
                    Margin="0,0,0,7"/>


                <TextBox
                    x:Name="txtMonto"
                    Style="{StaticResource ModernTextBoxStyle}"
                    Margin="0,0,0,20"/>


                <TextBlock
                    Text="OBSERVACIÓN"
                    Foreground="#64748B"
                    FontSize="10"
                    FontWeight="Bold"
                    Margin="0,0,0,7"/>


                <TextBox
                    x:Name="txtObservacion"
                    Style="{StaticResource ModernTextBoxStyle}"
                    Height="65"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"/>

            </StackPanel>

        </Border>


        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Cancelar"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="0,0,12,0"
                Click="BtnCancelar_Click"/>


            <Button
                x:Name="btnAplicar"
                Content="Aplicar adelanto"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="BtnAplicar_Click"/>

        </StackPanel>

    </Grid>

</Window>