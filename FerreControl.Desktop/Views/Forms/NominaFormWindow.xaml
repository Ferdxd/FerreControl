<Window x:Class="FerreControl.Desktop.Views.Forms.NominaFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva nómina"
        Width="520"
        Height="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- CABECERA -->

        <StackPanel>

            <TextBlock
                Text="Nueva nómina"
                Foreground="White"
                FontSize="24"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Define el período que será utilizado para calcular los pagos."
                Foreground="{StaticResource TextSecondaryBrush}"
                Margin="0,7,0,0"/>

        </StackPanel>


        <!-- FORMULARIO -->

        <Border
            Grid.Row="1"
            Style="{StaticResource CardStyle}"
            Margin="0,25,0,25">

            <StackPanel>


                <TextBlock
                    Text="FECHA INICIO"
                    Foreground="#64748B"
                    FontSize="10"
                    FontWeight="Bold"
                    Margin="0,0,0,7"/>


                <DatePicker
                    x:Name="dpFechaInicio"
                    Style="{StaticResource ModernDatePickerStyle}"
                    SelectedDateFormat="Short"
                    Margin="0,0,0,20"/>


                <TextBlock
                    Text="FECHA FIN"
                    Foreground="#64748B"
                    FontSize="10"
                    FontWeight="Bold"
                    Margin="0,0,0,7"/>


                <DatePicker
                    x:Name="dpFechaFin"
                    Style="{StaticResource ModernDatePickerStyle}"
                    SelectedDateFormat="Short"/>


            </StackPanel>

        </Border>


        <!-- BOTONES -->

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Cancelar"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="0,0,12,0"
                Click="BtnCancelar_Click"/>


            <Button
                x:Name="btnGuardar"
                Content="Crear nómina"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="BtnGuardar_Click"/>

        </StackPanel>

    </Grid>

</Window>