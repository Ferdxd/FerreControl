<Window x:Class="FerreControl.Desktop.Views.Forms.ConfigurarHoraExtraEmpleadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar horas extra"
        Width="620"
        Height="690"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <StackPanel>
            <TextBlock
                Text="Configuración de horas extra"
                Style="{StaticResource PageTitleStyle}"/>

            <TextBlock
                x:Name="txtEmpleado"
                Text="--"
                Foreground="{StaticResource TextSecondaryBrush}"
                FontSize="13"
                Margin="0,6,0,0"/>
        </StackPanel>

        <!-- FORMULARIO -->
        <Border
            Grid.Row="1"
            Style="{StaticResource CardStyle}"
            Margin="0,24,0,20">

            <StackPanel>

                <!-- CONFIGURACIÓN ACTUAL -->
                <Border
                    x:Name="panelActual"
                    Background="#0D1626"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,20">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                Text="CONFIGURACIÓN ACTUAL"
                                Foreground="#64748B"
                                FontSize="10"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="txtReglaActual"
                                Text="Sin configuración"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"/>

                            <TextBlock
                                x:Name="txtTarifaActual"
                                Text="--"
                                Foreground="{StaticResource AccentLightBrush}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Text="VIGENTE DESDE"
                                Foreground="#64748B"
                                FontSize="10"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="txtFechaActual"
                                Text="--"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- APLICA -->
                <CheckBox
                    x:Name="chkAplicaHorasExtra"
                    Content="Empleado habilitado para realizar horas extra"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Margin="0,0,0,18"
                    Checked="ChkAplicaHorasExtra_Changed"
                    Unchecked="ChkAplicaHorasExtra_Changed"/>

                <TextBlock
                    Text="FerreControl solo calculará y llevará horas extra a nómina mientras exista una configuración activa."
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Margin="24,-10,0,20"/>

                <!-- REGLA -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Text="REGLA DE HORAS EXTRA"
                            Foreground="#64748B"
                            FontSize="10"
                            FontWeight="Bold"
                            Margin="0,0,0,7"/>

                        <ComboBox
                            x:Name="cmbRegla"
                            Style="{StaticResource ModernComboBoxStyle}"
                            DisplayMemberPath="Descripcion"
                            SelectionChanged="CmbRegla_SelectionChanged"/>
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Content="Administrar reglas"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="BtnAdministrarReglas_Click"/>
                </Grid>

                <!-- TARIFA -->
                <Border
                    Background="#0D1626"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,18,0,18">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                Text="TARIFA DE LA REGLA"
                                Foreground="#64748B"
                                FontSize="10"
                                FontWeight="Bold"/>

                            <TextBlock
                                x:Name="txtTarifaSeleccionada"
                                Text="--"
                                Foreground="{StaticResource SuccessBrush}"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0"/>
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Text="por hora extra"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            VerticalAlignment="Bottom"
                            Margin="15,0,0,4"/>
                    </Grid>
                </Border>

                <!-- FECHA -->
                <TextBlock
                    x:Name="txtEtiquetaFecha"
                    Text="FECHA DE INICIO"
                    Foreground="#64748B"
                    FontSize="10"
                    FontWeight="Bold"
                    Margin="0,0,0,7"/>

                <DatePicker
                    x:Name="dpFechaVigencia"
                    Style="{StaticResource ModernDatePickerStyle}"
                    SelectedDateFormat="Short"
                    Margin="0,0,0,18"/>

                <!-- AVISO -->
                <Border
                    Background="#2A2111"
                    BorderBrush="#634B18"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="13">

                    <TextBlock
                        x:Name="txtAviso"
                        Text="Cambiar una regla no elimina el historial. La configuración anterior se cerrará el día anterior a la nueva vigencia."
                        Foreground="#FBBF24"
                        FontSize="11"
                        TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </Border>

        <!-- BOTONES -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Content="Cancelar"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="BtnCancelar_Click"/>

            <Button
                x:Name="btnGuardar"
                Grid.Column="2"
                Content="Guardar configuración"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="BtnGuardar_Click"/>
        </Grid>

    </Grid>
</Window>
