<Window x:Class="FerreControl.Desktop.Views.AdelantosEmpleadoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de adelantos"
        Width="1100"
        Height="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- CABECERA -->

        <StackPanel>

            <TextBlock
                Text="Historial de adelantos"
                Foreground="White"
                FontSize="24"
                FontWeight="SemiBold"/>


            <TextBlock
                x:Name="txtEmpleado"
                Foreground="{StaticResource TextSecondaryBrush}"
                Margin="0,7,0,0"/>

        </StackPanel>


        <!-- RESUMEN -->

        <Grid
            Grid.Row="1"
            Margin="0,22,0,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="12"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="TOTAL ENTREGADO"
                        Foreground="#64748B"
                        FontSize="10"/>


                    <TextBlock
                        x:Name="txtTotalEntregado"
                        Text="Q 0.00"
                        Foreground="White"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="TOTAL APLICADO"
                        Foreground="#64748B"
                        FontSize="10"/>


                    <TextBlock
                        x:Name="txtTotalAplicado"
                        Text="Q 0.00"
                        Foreground="{StaticResource SuccessBrush}"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <Border
                Grid.Column="4"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="SALDO PENDIENTE"
                        Foreground="#64748B"
                        FontSize="10"/>


                    <TextBlock
                        x:Name="txtSaldoPendiente"
                        Text="Q 0.00"
                        Foreground="{StaticResource WarningBrush}"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- HISTORIAL -->

        <DataGrid
            x:Name="dgAdelantos"
            Grid.Row="2"
            Style="{StaticResource DarkDataGridStyle}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="FullRow">

            <DataGrid.Columns>


                <DataGridTextColumn
                    Header="Fecha y hora"
                    Binding="{Binding FechaAdelanto,
                    StringFormat='dd/MM/yyyy HH:mm'}"
                    Width="140"/>


                <DataGridTextColumn
                    Header="Monto"
                    Binding="{Binding Monto,
                    StringFormat='Q {0:N2}'}"
                    Width="110"/>


                <DataGridTextColumn
                    Header="Aplicado"
                    Binding="{Binding TotalAplicado,
                    StringFormat='Q {0:N2}'}"
                    Width="110"/>


                <DataGridTextColumn
                    Header="Pendiente"
                    Binding="{Binding SaldoPendiente,
                    StringFormat='Q {0:N2}'}"
                    Width="110"/>


                <DataGridTextColumn
                    Header="Método"
                    Binding="{Binding MetodoEntrega}"
                    Width="120"/>


                <DataGridTextColumn
                    Header="Referencia"
                    Binding="{Binding Referencia}"
                    Width="140"/>


                <DataGridTextColumn
                    Header="Estado"
                    Binding="{Binding Estado}"
                    Width="100"/>


                <DataGridTextColumn
                    Header="Observación"
                    Binding="{Binding Observacion}"
                    Width="*"/>


                <DataGridTextColumn
                    Header="Registrado"
                    Binding="{Binding FechaCreacion,
                    StringFormat='dd/MM/yyyy HH:mm:ss'}"
                    Width="155"/>


            </DataGrid.Columns>

        </DataGrid>


        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">

            <Button
                Content="Cerrar"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="BtnCerrar_Click"/>

        </StackPanel>

    </Grid>

</Window>