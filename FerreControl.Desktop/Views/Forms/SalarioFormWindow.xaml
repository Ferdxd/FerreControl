<Window x:Class="FerreControl.Desktop.Views.Forms.SalarioFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salario"
        Width="580"
        Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- CABECERA -->

        <StackPanel>

            <TextBlock
                x:Name="txtTitulo"
                Text="Registrar salario"
                Style="{StaticResource PageTitleStyle}"/>

            <TextBlock
                x:Name="txtSubtitulo"
                Text="Registra el salario vigente del empleado."
                Foreground="{StaticResource TextSecondaryBrush}"
                Margin="0,6,0,0"/>

        </StackPanel>


        <!-- FORMULARIO -->

        <Border
            Grid.Row="1"
            Style="{StaticResource CardStyle}"
            Margin="0,25,0,20">

            <StackPanel>


                <!-- EMPLEADO -->

                <TextBlock
                    Text="Empleado"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,6"/>


                <ComboBox
                    x:Name="cmbEmpleado"
                    Style="{StaticResource ModernComboBoxStyle}"
                    SelectionChanged="CmbEmpleado_SelectionChanged"
                    Margin="0,0,0,18">

                    <ComboBox.ItemTemplate>

                        <DataTemplate>

                            <TextBlock Foreground="White">

                                <Run Text="{Binding Codigo}"/>

                                <Run Text=" - "/>

                                <Run Text="{Binding Nombres}"/>

                                <Run Text=" "/>

                                <Run Text="{Binding Apellidos}"/>

                            </TextBlock>

                        </DataTemplate>

                    </ComboBox.ItemTemplate>

                </ComboBox>


                <!-- SALARIO ACTUAL -->

                <Border
                    x:Name="panelSalarioActual"
                    Background="#0D1626"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,18"
                    Visibility="Collapsed">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock
                                Text="SALARIO ACTUAL"
                                Foreground="#64748B"
                                FontSize="10"/>

                            <TextBlock
                                x:Name="txtMontoActual"
                                Text="--"
                                Foreground="White"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Margin="0,4,0,0"/>

                        </StackPanel>


                        <StackPanel Grid.Column="1">

                            <TextBlock
                                Text="DESDE"
                                Foreground="#64748B"
                                FontSize="10"/>

                            <TextBlock
                                x:Name="txtFechaActual"
                                Text="--"
                                Foreground="White"
                                FontWeight="SemiBold"
                                Margin="0,4,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- MONTO -->

                <TextBlock
                    Text="Nuevo salario"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,6"/>

                <TextBox
                    x:Name="txtMonto"
                    Style="{StaticResource ModernTextBoxStyle}"
                    Margin="0,0,0,18"/>


                <!-- PERIODICIDAD -->

                <TextBlock
                    Text="Periodicidad"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,6"/>

                <ComboBox
                    x:Name="cmbPeriodicidad"
                    Style="{StaticResource ModernComboBoxStyle}"
                    Margin="0,0,0,18">

                    <ComboBoxItem Content="Semanal"/>
                    <ComboBoxItem Content="Quincenal"/>
                    <ComboBoxItem Content="Mensual"/>

                </ComboBox>


                <!-- FECHA -->

                <TextBlock
                    Text="Fecha de inicio"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Margin="0,0,0,6"/>

                <DatePicker
                    x:Name="dpFechaInicio"
                    Style="{StaticResource ModernDatePickerStyle}"
                    SelectedDateFormat="Short"/>

            </StackPanel>

        </Border>


        <!-- BOTONES -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Button
                Grid.Column="0"
                Content="Cancelar"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="BtnCancelar_Click"/>


            <Button
                x:Name="btnGuardar"
                Grid.Column="2"
                Content="Guardar salario"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="BtnGuardar_Click"/>

        </Grid>

    </Grid>

</Window>