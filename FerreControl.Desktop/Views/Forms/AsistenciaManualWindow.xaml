<Window x:Class="FerreControl.Desktop.Views.Forms.AsistenciaManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro manual de asistencia"
        Width="650"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- CABECERA                                              -->
        <!-- ===================================================== -->

        <StackPanel>

            <TextBlock
                x:Name="txtTitulo"
                Text="Registro manual de asistencia"
                Foreground="White"
                FontSize="24"
                FontWeight="SemiBold"/>


            <TextBlock
                x:Name="txtModo"
                Text="Registra únicamente las marcaciones que hagan falta."
                Foreground="{StaticResource TextSecondaryBrush}"
                FontSize="12"
                Margin="0,7,0,0"
                TextWrapping="Wrap"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- FORMULARIO                                            -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="1"
            Style="{StaticResource CardStyle}"
            Margin="0,22,0,22">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto">

                <StackPanel>


                    <!-- EMPLEADO -->

                    <TextBlock
                        Text="EMPLEADO"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"
                        Margin="0,0,0,7"/>


                    <ComboBox
                        x:Name="cmbEmpleado"
                        Style="{StaticResource ModernComboBoxStyle}"
                        Margin="0,0,0,18"
                        SelectionChanged="CmbEmpleado_SelectionChanged">

                        <ComboBox.ItemTemplate>

                            <DataTemplate>

                                <StackPanel
                                    Orientation="Horizontal">

                                    <TextBlock
                                        Text="{Binding Codigo}"
                                        Foreground="{StaticResource AccentLightBrush}"
                                        Margin="0,0,10,0"/>

                                    <TextBlock
                                        Text="{Binding Nombres}"
                                        Foreground="White"/>

                                    <TextBlock
                                        Text=" "
                                        Foreground="White"/>

                                    <TextBlock
                                        Text="{Binding Apellidos}"
                                        Foreground="White"/>

                                </StackPanel>

                            </DataTemplate>

                        </ComboBox.ItemTemplate>

                    </ComboBox>


                    <!-- FECHA -->

                    <TextBlock
                        Text="FECHA"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"
                        Margin="0,0,0,7"/>


                    <DatePicker
                        x:Name="dpFecha"
                        Style="{StaticResource ModernDatePickerStyle}"
                        SelectedDateFormat="Short"
                        Margin="0,0,0,20"
                        SelectedDateChanged="DpFecha_SelectedDateChanged"/>


                    <!-- HORAS -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="15"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="ENTRADA"
                                Foreground="#64748B"
                                FontSize="10"
                                FontWeight="Bold"
                                Margin="0,0,0,7"/>

                            <TextBox
                                x:Name="txtEntrada"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Margin="0,0,0,18"/>


                            <TextBlock
                                Text="REGRESO DE DESCANSO"
                                Foreground="#64748B"
                                FontSize="10"
                                FontWeight="Bold"
                                Margin="0,0,0,7"/>

                            <TextBox
                                x:Name="txtFinDescanso"
                                Style="{StaticResource ModernTextBoxStyle}"/>

                        </StackPanel>


                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="SALIDA A DESCANSO"
                                Foreground="#64748B"
                                FontSize="10"
                                FontWeight="Bold"
                                Margin="0,0,0,7"/>

                            <TextBox
                                x:Name="txtInicioDescanso"
                                Style="{StaticResource ModernTextBoxStyle}"
                                Margin="0,0,0,18"/>


                            <TextBlock
                                Text="SALIDA FINAL"
                                Foreground="#64748B"
                                FontSize="10"
                                FontWeight="Bold"
                                Margin="0,0,0,7"/>

                            <TextBox
                                x:Name="txtSalida"
                                Style="{StaticResource ModernTextBoxStyle}"/>

                        </StackPanel>

                    </Grid>


                    <TextBlock
                        Text="Formato: HH:mm. Ejemplo: 07:30. Las marcaciones ya existentes se bloquean para evitar modificar el historial."
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="10"
                        TextWrapping="Wrap"
                        Margin="0,12,0,20"/>


                    <!-- OBSERVACIÓN -->

                    <TextBlock
                        Text="OBSERVACIÓN"
                        Foreground="#64748B"
                        FontSize="10"
                        FontWeight="Bold"
                        Margin="0,0,0,7"/>


                    <TextBox
                        x:Name="txtObservacion"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Height="70"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"/>


                    <TextBlock
                        Text="Las marcaciones manuales quedan identificadas con el método MANUAL."
                        Foreground="{StaticResource WarningBrush}"
                        FontSize="10"
                        TextWrapping="Wrap"
                        Margin="0,14,0,0"/>

                </StackPanel>

            </ScrollViewer>

        </Border>


        <!-- ===================================================== -->
        <!-- BOTONES                                               -->
        <!-- ===================================================== -->

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Cerrar"
                Style="{StaticResource SecondaryButtonStyle}"
                Margin="0,0,12,0"
                Click="BtnCancelar_Click"/>


            <Button
                x:Name="btnGuardar"
                Content="Guardar marcaciones"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="BtnGuardar_Click"/>

        </StackPanel>

    </Grid>

</Window>