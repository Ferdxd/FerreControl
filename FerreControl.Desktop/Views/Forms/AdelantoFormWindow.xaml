<Window x:Class="FerreControl.Desktop.Views.AdelantoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adelantos del empleado"
        Width="780"
        Height="850"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- CABECERA                                              -->
        <!-- ===================================================== -->

        <StackPanel>

            <TextBlock
                Text="Adelantos"
                Foreground="White"
                FontSize="24"
                FontWeight="SemiBold"/>


            <TextBlock
                x:Name="txtEmpleado"
                Foreground="{StaticResource TextSecondaryBrush}"
                FontSize="13"
                Margin="0,7,0,0"/>


            <TextBlock
                x:Name="txtEstadoNomina"
                Foreground="{StaticResource AccentLightBrush}"
                FontSize="11"
                Margin="0,5,0,0"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- CONTENIDO                                             -->
        <!-- ===================================================== -->

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            Margin="0,22,0,0">

            <StackPanel>


                <!-- ================================================= -->
                <!-- ADELANTOS PENDIENTES                              -->
                <!-- ================================================= -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,18">

                    <StackPanel>


                        <TextBlock
                            Text="Adelantos pendientes"
                            Style="{StaticResource SectionTitleStyle}"/>


                        <TextBlock
                            Text="Dinero entregado anteriormente al empleado que todavía tiene saldo pendiente."
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Margin="0,5,0,15"/>


                        <TextBlock
                            x:Name="txtSinPendientes"
                            Text="El empleado no tiene adelantos pendientes."
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="12"
                            Visibility="Collapsed"
                            Margin="0,5,0,15"/>


                        <DataGrid
                            x:Name="dgPendientes"
                            Style="{StaticResource DarkDataGridStyle}"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            Height="180"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            SelectionChanged="DgPendientes_SelectionChanged">

                            <DataGrid.Columns>


                                <DataGridTextColumn
                                    Header="Fecha y hora"
                                    Binding="{Binding FechaAdelanto,
                                    StringFormat='dd/MM/yyyy HH:mm'}"
                                    Width="150"/>


                                <DataGridTextColumn
                                    Header="Entregado"
                                    Binding="{Binding Monto,
                                    StringFormat='Q {0:N2}'}"
                                    Width="115"/>


                                <DataGridTextColumn
                                    Header="Aplicado"
                                    Binding="{Binding TotalAplicado,
                                    StringFormat='Q {0:N2}'}"
                                    Width="115"/>


                                <DataGridTextColumn
                                    Header="Pendiente"
                                    Binding="{Binding SaldoPendiente,
                                    StringFormat='Q {0:N2}'}"
                                    Width="115"/>


                                <DataGridTextColumn
                                    Header="Estado"
                                    Binding="{Binding Estado}"
                                    Width="*"/>


                            </DataGrid.Columns>

                        </DataGrid>


                        <Grid Margin="0,15,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="15"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="MONTO A DESCONTAR EN ESTA NÓMINA"
                                    Foreground="#64748B"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Margin="0,0,0,7"/>


                                <TextBox
                                    x:Name="txtMontoAplicarPendiente"
                                    Style="{StaticResource ModernTextBoxStyle}"
                                    IsEnabled="False"/>

                            </StackPanel>


                            <Button
                                x:Name="btnAplicarPendiente"
                                Grid.Column="2"
                                Content="Aplicar seleccionado"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Bottom"
                                IsEnabled="False"
                                Click="BtnAplicarPendiente_Click"/>

                        </Grid>


                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- NUEVO ADELANTO                                    -->
                <!-- ================================================= -->

                <Border
                    Style="{StaticResource CardStyle}">

                    <StackPanel>


                        <TextBlock
                            Text="Registrar nuevo adelanto"
                            Style="{StaticResource SectionTitleStyle}"/>


                        <TextBlock
                            Text="Registra el dinero que se está entregando al empleado."
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="11"
                            Margin="0,5,0,18"/>


                        <!-- MONTO -->

                        <TextBlock
                            Text="MONTO ENTREGADO"
                            Foreground="#64748B"
                            FontSize="10"
                            FontWeight="Bold"
                            Margin="0,0,0,7"/>


                        <TextBox
                            x:Name="txtMonto"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Margin="0,0,0,18"
                            TextChanged="TxtMonto_TextChanged"/>


                        <!-- FECHA / HORA -->

                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="15"/>

                                <ColumnDefinition Width="180"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                    Text="FECHA DE ENTREGA"
                                    Foreground="#64748B"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Margin="0,0,0,7"/>


                                <DatePicker
                                    x:Name="dpFecha"
                                    Style="{StaticResource ModernDatePickerStyle}"
                                    SelectedDateFormat="Short"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock
                                    Text="HORA DE ENTREGA"
                                    Foreground="#64748B"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Margin="0,0,0,7"/>


                                <TextBox
                                    x:Name="txtHora"
                                    Style="{StaticResource ModernTextBoxStyle}"/>

                            </StackPanel>

                        </Grid>


                        <TextBlock
                            Text="Formato de hora: HH:mm. Ejemplo: 15:25"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="10"
                            Margin="0,-10,0,18"/>


                        <!-- MÉTODO -->

                        <TextBlock
                            Text="MÉTODO DE ENTREGA"
                            Foreground="#64748B"
                            FontSize="10"
                            FontWeight="Bold"
                            Margin="0,0,0,7"/>


                        <ComboBox
                            x:Name="cmbMetodo"
                            Style="{StaticResource ModernComboBoxStyle}"
                            Margin="0,0,0,18">

                            <ComboBoxItem Content="EFECTIVO"/>

                            <ComboBoxItem Content="TRANSFERENCIA"/>

                            <ComboBoxItem Content="DEPOSITO"/>

                            <ComboBoxItem Content="OTRO"/>

                        </ComboBox>


                        <!-- REFERENCIA -->

                        <TextBlock
                            Text="REFERENCIA / COMPROBANTE"
                            Foreground="#64748B"
                            FontSize="10"
                            FontWeight="Bold"
                            Margin="0,0,0,7"/>


                        <TextBox
                            x:Name="txtReferencia"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Margin="0,0,0,18"/>


                        <!-- OBSERVACIÓN -->

                        <TextBlock
                            Text="OBSERVACIÓN"
                            Foreground="#64748B"
                            FontSize="10"
                            FontWeight="Bold"
                            Margin="0,0,0,7"/>


                        <TextBox
                            x:Name="txtObservacion"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Height="65"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Margin="0,0,0,18"/>


                        <!-- APLICAR AUTOMÁTICAMENTE -->

                        <Border
                            Background="#0D1626"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,18">

                            <StackPanel>


                                <CheckBox
                                    x:Name="chkAplicarNomina"
                                    Content="Descontar este adelanto de la nómina actual"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Checked="ChkAplicarNomina_Changed"
                                    Unchecked="ChkAplicarNomina_Changed"/>


                                <TextBlock
                                    Text="Puede descontar todo el adelanto o solamente una parte."
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="10"
                                    Margin="24,5,0,12"/>


                                <StackPanel>

                                    <TextBlock
                                        Text="MONTO A DESCONTAR"
                                        Foreground="#64748B"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Margin="0,0,0,7"/>


                                    <TextBox
                                        x:Name="txtMontoAplicarNuevo"
                                        Style="{StaticResource ModernTextBoxStyle}"
                                        IsEnabled="False"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>


                        <TextBlock
                            Text="La fecha y hora del registro en el sistema también se guardarán automáticamente."
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="10"
                            TextWrapping="Wrap"
                            Margin="0,0,0,18"/>


                        <!-- BOTONES -->

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">


                            <Button
                                Content="Cancelar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,12,0"
                                Click="BtnCancelar_Click"/>


                            <Button
                                x:Name="btnGuardar"
                                Content="Registrar adelanto"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnGuardar_Click"/>

                        </StackPanel>


                    </StackPanel>

                </Border>


            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>