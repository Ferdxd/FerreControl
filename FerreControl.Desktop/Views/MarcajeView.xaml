<UserControl x:Class="FerreControl.Desktop.Views.MarcajeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =====================================================
             CABECERA
             ===================================================== -->

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="Registro de asistencia"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Escanea el código de barras del carné. FerreControl determinará automáticamente la marcación."
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="13"
                    Margin="0,6,0,0"/>

            </StackPanel>


            <!-- ESTADO LECTOR -->

            <Border
                Grid.Column="1"
                Background="#0B2B25"
                BorderBrush="#145A4C"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14,7"
                VerticalAlignment="Center">

                <StackPanel
                    Orientation="Horizontal">

                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{StaticResource SuccessBrush}"
                        Margin="0,0,8,0"/>

                    <TextBlock
                        Text="LECTOR DE CÓDIGO LISTO"
                        Foreground="#6EE7B7"
                        FontSize="11"
                        FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- =====================================================
             CONTENIDO
             ===================================================== -->

        <Grid
            Grid.Row="1"
            Margin="0,22,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="20"/>

                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>


            <!-- =================================================
                 PANEL DE MARCAJE
                 ================================================= -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- =========================================
                         RELOJ
                         ========================================= -->

                    <StackPanel
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="HORA ACTUAL"
                            Foreground="#64748B"
                            FontSize="11"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"/>


                        <TextBlock
                            x:Name="txtHoraMarcaje"
                            Text="--:--:--"
                            Foreground="White"
                            FontSize="54"
                            FontWeight="Light"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"/>


                        <TextBlock
                            x:Name="txtFechaMarcaje"
                            Text="--"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- =========================================
                         LECTOR
                         ========================================= -->

                    <StackPanel
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="540">


                        <!-- ICONO -->

                        <Border
                            Width="92"
                            Height="92"
                            CornerRadius="46"
                            Background="#15284A"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20">

                            <TextBlock
                                Text="▥"
                                Foreground="{StaticResource AccentLightBrush}"
                                FontSize="42"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <TextBlock
                            Text="Escanea tu carné"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="25"
                            HorizontalAlignment="Center"/>


                        <TextBlock
                            Text="No necesitas seleccionar entrada o salida. FerreControl lo hará automáticamente."
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="13"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,20"/>


                        <!-- TIPO FIJO -->

                        <Border
                            Background="#0D1626"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,9"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,15">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Text="IDENTIFICACIÓN"
                                    Foreground="#64748B"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"/>


                                <TextBlock
                                    Grid.Column="1"
                                    Text="Código de barras"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center"/>


                                <Border
                                    Grid.Column="2"
                                    Background="#0B2B25"
                                    CornerRadius="5"
                                    Padding="8,3">

                                    <TextBlock
                                        Text="ACTIVO"
                                        Foreground="#6EE7B7"
                                        FontSize="9"
                                        FontWeight="Bold"/>

                                </Border>

                            </Grid>

                        </Border>


                        <TextBlock
                            Text="CÓDIGO DE CREDENCIAL"
                            Foreground="#64748B"
                            FontSize="10"
                            FontWeight="Bold"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,6"/>


                        <!-- CAMPO DONDE ESCRIBE EL LECTOR -->

                        <TextBox
                            x:Name="txtCodigoMarcaje"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Height="58"
                            FontSize="20"
                            TextAlignment="Center"
                            VerticalContentAlignment="Center"
                            MaxLength="150"
                            PreviewKeyDown="TxtCodigoMarcaje_PreviewKeyDown"/>


                        <!-- BOTÓN PARA PRUEBAS/MANUAL DEL CÓDIGO -->

                        <Button
                            x:Name="btnRegistrarCodigo"
                            Content="Registrar código"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="40"
                            Margin="0,12,0,0"
                            Click="BtnRegistrarCodigo_Click"/>


                        <TextBlock
                            Text="El lector USB escribe el código del carné y envía ENTER automáticamente."
                            Foreground="#64748B"
                            FontSize="11"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"/>


                        <TextBlock
                            Text="El registro manual de asistencia se realiza desde el módulo Asistencia."
                            Foreground="#64748B"
                            FontSize="11"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- =========================================
                         ESTADO
                         ========================================= -->

                    <Border
                        Grid.Row="2"
                        Background="#0D1626"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Ellipse
                                x:Name="ellEstadoMarcaje"
                                Width="9"
                                Height="9"
                                Fill="{StaticResource AccentLightBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"/>


                            <TextBlock
                                x:Name="txtEstadoMarcaje"
                                Grid.Column="1"
                                Text="Esperando lectura del carné..."
                                Foreground="{StaticResource TextSecondaryBrush}"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>


            <!-- =================================================
                 ÚLTIMA MARCACIÓN
                 ================================================= -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="Última marcación"
                        Style="{StaticResource SectionTitleStyle}"/>


                    <TextBlock
                        Text="Información del último empleado registrado."
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="12"
                        Margin="0,5,0,28"/>


                    <!-- INICIALES -->

                    <Border
                        Width="82"
                        Height="82"
                        CornerRadius="41"
                        Background="#172C50"
                        HorizontalAlignment="Left">

                        <TextBlock
                            x:Name="txtInicialesEmpleado"
                            Text="--"
                            Foreground="{StaticResource AccentLightBrush}"
                            FontSize="25"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>


                    <!-- EMPLEADO -->

                    <TextBlock
                        x:Name="txtNombreEmpleado"
                        Text="Sin marcaciones"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Margin="0,18,0,0"/>


                    <TextBlock
                        x:Name="txtCodigoEmpleado"
                        Text="Código: --"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Margin="0,6,0,0"/>


                    <Border
                        Height="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,24"/>


                    <!-- TIPO -->

                    <TextBlock
                        Text="Tipo de marcación"
                        Foreground="#64748B"
                        FontSize="11"/>


                    <TextBlock
                        x:Name="txtTipoMarcacion"
                        Text="--"
                        Foreground="White"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Margin="0,4,0,18"/>


                    <!-- MÉTODO -->

                    <TextBlock
                        Text="Método"
                        Foreground="#64748B"
                        FontSize="11"/>


                    <TextBlock
                        x:Name="txtMetodoMarcacion"
                        Text="--"
                        Foreground="White"
                        FontSize="13"
                        Margin="0,4,0,18"/>


                    <!-- HORA -->

                    <TextBlock
                        Text="Hora registrada"
                        Foreground="#64748B"
                        FontSize="11"/>


                    <TextBlock
                        x:Name="txtHoraRegistrada"
                        Text="--:--"
                        Foreground="{StaticResource SuccessBrush}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,4,0,0"/>


                    <!-- MENSAJE -->

                    <Border
                        x:Name="panelResultadoMarcaje"
                        Background="#0B2B25"
                        BorderBrush="#145A4C"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,24,0,0"
                        Visibility="Collapsed">

                        <TextBlock
                            x:Name="txtResultadoMarcaje"
                            Text=""
                            Foreground="#6EE7B7"
                            TextWrapping="Wrap"
                            FontWeight="SemiBold"/>

                    </Border>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>