<UserControl x:Class="FerreControl.Desktop.Views.MarcajeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- CABECERA -->

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="Registro de asistencia"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Escanea la credencial del empleado para registrar su marcación."
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="13"
                    Margin="0,6,0,0"/>

            </StackPanel>


            <Border
                Grid.Column="1"
                Background="#0B2B25"
                BorderBrush="#145A4C"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14,7"
                VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">

                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{StaticResource SuccessBrush}"
                        Margin="0,0,8,0"/>

                    <TextBlock
                        Text="LECTOR LISTO"
                        Foreground="#6EE7B7"
                        FontSize="11"
                        FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- CONTENIDO -->

        <Grid
            Grid.Row="1"
            Margin="0,22,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2*"/>

                <ColumnDefinition Width="20"/>

                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>


            <!-- MARCAJE PRINCIPAL -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <StackPanel
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="HORA DEL SERVIDOR"
                            Foreground="#64748B"
                            FontSize="11"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            x:Name="txtHoraMarcaje"
                            Text="07:02:15"
                            Foreground="White"
                            FontSize="54"
                            FontWeight="Light"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"/>

                        <TextBlock
                            Text="Miércoles, 07 de octubre de 2026"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="14"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0"/>

                    </StackPanel>


                    <StackPanel
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Width="520">

                        <Border
                            Width="84"
                            Height="84"
                            CornerRadius="42"
                            Background="#15284A"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,22">

                            <TextBlock
                                Text="▣"
                                Foreground="{StaticResource AccentLightBrush}"
                                FontSize="38"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <TextBlock
                            Text="Acerque o escanee su tarjeta"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="23"
                            HorizontalAlignment="Center"/>

                        <TextBlock
                            Text="El registro se realizará automáticamente."
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="13"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,20"/>


                        <TextBox
                            x:Name="txtCodigoMarcaje"
                            Style="{StaticResource ModernTextBoxStyle}"
                            Height="54"
                            FontSize="20"
                            TextAlignment="Center"
                            VerticalContentAlignment="Center"
                            MaxLength="150"/>


                        <TextBlock
                            Text="Compatible con código de barras, QR y otros lectores tipo teclado."
                            Foreground="#64748B"
                            FontSize="11"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"/>

                    </StackPanel>


                    <!-- ESTADO -->

                    <Border
                        Grid.Row="2"
                        Background="#0D1626"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse
                                Width="9"
                                Height="9"
                                Fill="{StaticResource AccentLightBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"/>

                            <TextBlock
                                x:Name="txtEstadoMarcaje"
                                Text="Esperando lectura de credencial..."
                                Foreground="{StaticResource TextSecondaryBrush}"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ÚLTIMA MARCACIÓN -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock
                        Text="Última marcación"
                        Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock
                        Text="Información del último empleado registrado"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="12"
                        Margin="0,5,0,28"/>


                    <Border
                        Width="82"
                        Height="82"
                        CornerRadius="41"
                        Background="#172C50"
                        HorizontalAlignment="Left">

                        <TextBlock
                            x:Name="txtInicialesEmpleado"
                            Text="--"
                            Foreground="{StaticResource AccentLightBrush}"
                            FontSize="25"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>


                    <TextBlock
                        x:Name="txtNombreEmpleado"
                        Text="Sin marcaciones"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,18,0,0"/>


                    <TextBlock
                        x:Name="txtCodigoEmpleado"
                        Text="Código: --"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Margin="0,6,0,0"/>


                    <Border
                        Height="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,24"/>


                    <TextBlock
                        Text="Tipo de marcación"
                        Foreground="#64748B"
                        FontSize="11"/>

                    <TextBlock
                        x:Name="txtTipoMarcacion"
                        Text="--"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Margin="0,4,0,18"/>


                    <TextBlock
                        Text="Hora registrada"
                        Foreground="#64748B"
                        FontSize="11"/>

                    <TextBlock
                        x:Name="txtHoraRegistrada"
                        Text="--:--"
                        Foreground="{StaticResource SuccessBrush}"
                        FontSize="26"
                        FontWeight="SemiBold"
                        Margin="0,4,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>